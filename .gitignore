# ==============================================================================
# OSINTiger — Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs
/.next/
/out/
/build/
.next/

# Environment Variables & Secrets (NEVER commit secrets)
.env
.env.local
.env.*.local
.env.*
!.env.example

# Local SQLite Database & Storage (Runtime state)
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm
prisma/db/

# Testing & Coverage
/coverage/
.nyc_output/

# Logs & Debug Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
dev.out.log
server.log
server_error.log
server_output.log

# Scratch Dumps, IDE Tool Results, Internal Agent Worklogs
tool-results/
upload/
worklog.md
.claude/
.z-ai-config/
local-*
test/
prompt/
download/

# Operating System & Editor Files
.DS_Store
*.pem
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel/

# Skills directory
/skills/